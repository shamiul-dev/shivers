{
  "name": "shivers-backend",
  "version": "0.1.0",
  "description": "Shivers Real-Time Chat Backend",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && tsc-alias --resolve-full-paths",
    "start": "node dist/index.js",
    "test": "node --import tsx --test --test-concurrency=1 --test-force-exit \"tests/*.test.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "better-auth": "^1.7.7",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "postgres": "^3.4.9",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "socket.io-client": "4.8.4",
    "supertest": "^7.3.2",
    "tsc-alias": "^1.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
